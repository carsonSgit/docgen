PORT=3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_VERIFY_REDIRECT_URI=http://localhost:3001/oauth/callback
WEB_ORIGIN=http://localhost:5173
# Optional provider-only verification token:
GOOGLE_ACCESS_TOKEN=
# Server-only durable OAuth token set (defaults to .data/google-oauth-token.json)
GOOGLE_TOKEN_FILE=.data/google-oauth-token.json
