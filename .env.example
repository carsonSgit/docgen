# Local development only: the Bun dev host listens here. Cloudflare Workers
# have no port binding, so PORT is never configured for a deployment.
PORT=3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API OAuth callback; also register this URI in the Google OAuth client.
# Required in every environment: there is no localhost fallback outside the
# Bun dev host.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Local development only: separate callback used solely by
# scripts/verify-google-oauth.ts. Never configured for a deployment.
GOOGLE_VERIFY_REDIRECT_URI=http://localhost:3001/oauth/callback
# Where the browser returns after Google authorization completes. Required in
# every environment; the deployed Worker serves the SPA from its own origin.
WEB_ORIGIN=http://localhost:5173
# Optional short-lived provider-only verification token; leave empty for browser OAuth.
GOOGLE_ACCESS_TOKEN=
# Local development only: path of the OAuth token file written by
# FileOAuthTokenStore. Workers have no writable filesystem; issue #213 moves
# this state to Workers KV.
GOOGLE_OAUTH_TOKEN_PATH=.data/google-oauth-token.json
