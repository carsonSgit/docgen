PORT=3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API OAuth callback; also register this URI in the Google OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Separate callback used only by scripts/verify-google-oauth.ts.
GOOGLE_VERIFY_REDIRECT_URI=http://localhost:3001/oauth/callback
WEB_ORIGIN=http://localhost:5173
# Optional short-lived provider-only verification token; leave empty for browser OAuth.
GOOGLE_ACCESS_TOKEN=
